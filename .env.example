# ============================================================
# Application
# ============================================================
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# 태그 카탈로그 파일 경로 (프로젝트 루트 기준 상대경로 또는 절대경로)
CATALOG_PATH=catalog/tags.yaml

# ============================================================
# OPC UA Client - Connection
# ============================================================
# 현장 서버 식별자. 카탈로그에서 태그가 어느 서버 소속인지 구분하는 데 사용
OPCUA_SERVER_ID=default
OPCUA_ENDPOINT=opc.tcp://localhost:4840/freeopcua/server/
OPCUA_CLIENT_NAME=middleware_gateway_opc_ua
OPCUA_APPLICATION_URI=urn:middleware:gateway:opcua:client

# 요청 응답 대기 시간(초)
OPCUA_TIMEOUT=4
# 서버 상태 확인(watchdog) 주기(초)
OPCUA_WATCHDOG_INTERVAL=1.0
# 세션 타임아웃(ms)
OPCUA_SESSION_TIMEOUT_MS=3600000

# 연결 유실 시 자동 재연결 (구독 자동 복구 포함)
OPCUA_AUTO_RECONNECT=true
# 재연결 지수 백오프 최대 대기(초)
OPCUA_RECONNECT_MAX_DELAY=30.0
# 최초 접속 실패 시 재시도 간격(초)
OPCUA_CONNECT_RETRY_INTERVAL=5.0
# 최초 접속 최대 재시도 횟수 (0 = 무제한)
OPCUA_CONNECT_MAX_RETRIES=0

# ============================================================
# OPC UA Client - Authentication (비우면 Anonymous)
# ============================================================
OPCUA_USERNAME=
OPCUA_PASSWORD=

# ============================================================
# OPC UA Client - Security
# ============================================================
# None | Basic256Sha256 | Aes128Sha256RsaOaep | Aes256Sha256RsaPss | Basic256 | Basic128Rsa15
OPCUA_SECURITY_POLICY=None
# Sign | SignAndEncrypt (SECURITY_POLICY 가 None 이 아닐 때만 사용)
OPCUA_SECURITY_MODE=SignAndEncrypt
# 클라이언트 인증서/개인키 경로 (프로젝트 루트 기준 상대경로 또는 절대경로)
OPCUA_CLIENT_CERT=
OPCUA_CLIENT_KEY=
# 서버 인증서 경로 (선택)
OPCUA_SERVER_CERT=

# ============================================================
# OPC UA Client - Subscription
# ============================================================
# 구독 publishing 주기(ms)
OPCUA_SUBSCRIPTION_PERIOD_MS=500
# 모니터링 샘플링 주기(ms)
OPCUA_SAMPLING_INTERVAL_MS=100
# 구독할 노드 ID 목록 (쉼표 구분). 예) ns=2;i=2,ns=2;s=Device1.Temperature
OPCUA_NODE_IDS=

# ============================================================
# Northbound OPC UA Server (상위 시스템에 데이터를 제공하는 게이트웨이 서버)
# ============================================================
# 현장 서버(기본 4840)와 같은 PC에서 돌릴 수 있도록 포트를 다르게 둔다
NORTHBOUND_ENDPOINT=opc.tcp://0.0.0.0:4841/gateway/
NORTHBOUND_SERVER_NAME=middleware_gateway_opc_ua
NORTHBOUND_APPLICATION_URI=urn:middleware:gateway:opcua:server
# 게이트웨이가 제공하는 태그 노드의 네임스페이스. 상위 시스템은 이 URI로 노드를 찾는다
NORTHBOUND_NAMESPACE_URI=urn:middleware:gateway:opcua:tags
